<PropertyList>

	<path>radarE3.ac</path>
	
	<animation>
		<type>material</type>
  		<object-name>sup</object-name>
		<condition>
			<not><property>sim/rendering/rembrandt/enabled</property></not>
			<property>systems/electrical/outputs/cabin-dim</property>
		</condition>
		<emission>
		  <red>0.3</red>
		  <green>0.3</green>
		  <blue>0.3</blue>
		  <factor-prop>/systems/electrical/outputs/cabin-dim</factor-prop>
		</emission>
	</animation>
	
	<animation>
		<type>material</type>
			<object-name>KnobRange</object-name>
			<object-name>KnobOnOff</object-name>
		<condition>
			<less-than><property>systems/electrical/outputs/cabin-dim</property><value>0.6</value></less-than>
		</condition>
		<emission>
			<red>0.3</red>
			<green>0.3</green>
			<blue>0.3</blue>
			<factor-prop>/systems/electrical/outputs/panel-dim</factor-prop>
		</emission>
	</animation>
	
	<animation>
		<type>material</type>
			<object-name>KnobRange</object-name>
			<object-name>KnobOnOff</object-name>
		<condition>
			<not><property>sim/rendering/rembrandt/enabled</property></not>
			<property>systems/electrical/outputs/cabin-dim</property>
		</condition>
		<emission>
		  <red>0.6</red>
		  <green>0.6</green>
		  <blue>0.6</blue>
		  <factor-prop>/systems/electrical/outputs/cabin-dim</factor-prop>
		</emission>
	</animation>
	
	<!-- the knob animations -->

	<animation>
		<type>rotate</type>
		<object-name>KnobOnOff</object-name>
		<property>instrumentation/radar/rwr-separate</property>
		<factor>-90</factor>
		<center>
			<x-m> 0.0</x-m>
			<y-m> 0.0521</y-m>
			<z-m>-0.0536</z-m>
		</center>
		<axis>
			<x>1</x>
			<y>0</y>
			<z>0</z>
		</axis>
	</animation>
	
	<animation>
		<type>pick</type>
		<object-name>KnobOnOff</object-name>
		<visible>true</visible>
		<action>
			<name>show info</name>
			<button>0</button>
			<repeatable>true</repeatable>			
			<binding>
				<command>property-toggle</command>
				<property>instrumentation/radar/rwr-separate</property>
			</binding>
		  <binding>
				<command>property-toggle</command>
				<property>sim/sound/switch1</property>
			</binding>
		</action>
	</animation>

<!-- TCAS ANIMATIONS -->

